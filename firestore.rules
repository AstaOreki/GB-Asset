rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    // Keep this list in sync with ADMIN_EMAILS in js/firebase-config.js.
    // (Firestore rules can't read your JS file, so the admin list has to be
    // duplicated here — this is what actually enforces admin-only access;
    // the ADMIN_EMAILS array in the JS is only a UI-level gate.)
    function adminEmails() {
      return [
        "astaoreki@gmail.com",
        "ezurazz@gmail.com"
      ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in adminEmails();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------- users
    // Each signed-in user can create/read/update only their own doc
    // (this is also where their cart lives, as a field on the doc).
    // No one can delete a user doc from the client.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- orders
    // Storefront checkout no longer creates orders straight from the
    // client — these rules could check status/createdAt/userId, but had
    // no way to verify that amount/items actually matched real product
    // prices, so a signed-in user could call the Firestore SDK directly
    // with a doctored amount. Order creation now goes through
    // app/api/create-order, which re-derives every price server-side via
    // firebase-admin (which bypasses these rules entirely) before
    // writing. The only client-side create left is the admin dashboard's
    // manual "New Order" quick-add for phone/walk-in sales.
    // A customer CAN read their own order (added for the bank-transfer
    // payment page, which needs to show live paymentStatus/receipt info
    // without a proxy API route) but can never write to it — every
    // mutation (receipt upload, admin confirm/reject) goes through
    // app/api/orders/* using firebase-admin, which bypasses this rule
    // entirely, so a customer can never set their own paymentStatus to
    // "confirmed" or forge a receipt.
    match /orders/{orderId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update, delete: if isAdmin();

      // Past receipt attempts (superseded/rejected uploads) — admin-only,
      // even though the parent order doc above is owner-readable. Keeping
      // this history in a subcollection rather than a field on the order
      // is what makes "customer sees their own order, but never another
      // attempt's history" a rule Firestore actually enforces, rather
      // than something only the UI happens to hide.
      match /receiptHistory/{historyId} {
        allow read, write: if isAdmin();
      }
    }

    // ------------------------------------------------------- consultations
    // Anyone can submit a consultation/contact request ("guest checkout"
    // style lead), always starting as a fresh, unassigned "new" lead.
    // Only admins can read, update (status/assignment), or delete leads.
    match /consultations/{leadId} {
      allow create: if request.resource.data.status == "new" &&
                       request.resource.data.assignedTo == "" &&
                       request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------ products
    // Public storefront needs to read live prices; only admins can write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------- announcements
    // Public site displays these; only admins can publish/delete.
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------- priceHistory
    // Public storefront reads the per-bar daily rate history for "Price
    // Today" — one doc per bar per calendar day (id "{productId}_{date}"),
    // upserted throughout the day as the admin edits it, so a past day's
    // doc is only ever touched on the day it represents. Only admins may
    // write; nothing can ever be deleted, so day-by-day history stays
    // intact for the 1W/1M/6M/1Y filters.
    match /priceHistory/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
                       request.resource.data.keys().hasOnly(['sell', 'buy', 'margin', 'weight', 'productName', 'productId', 'date', 'recordedAt']) &&
                       request.resource.data.sell is number && request.resource.data.sell > 0 &&
                       request.resource.data.buy is number && request.resource.data.buy > 0 &&
                       request.resource.data.weight is number && request.resource.data.weight > 0 &&
                       // Exact equality here used to fail on ordinary decimal
                       // rates (e.g. 538.32 - 538.00 isn't exactly 0.32 in
                       // floating point) — a small tolerance instead of "=="
                       // still rejects a genuinely wrong/tampered margin.
                       request.resource.data.margin >= (request.resource.data.sell - request.resource.data.buy) - 0.01 &&
                       request.resource.data.margin <= (request.resource.data.sell - request.resource.data.buy) + 0.01 &&
                       request.resource.data.recordedAt == request.time;
      allow delete: if false;
    }

    // -------------------------------------------------------- priceUpdates
    // The permanent audit trail: one doc per admin save, auto-id, appended
    // forever. Unlike priceHistory (one doc per bar per day, rewritten as
    // the admin edits that day) nothing here is ever modified — `update`
    // and `delete` are both denied outright, so several saves on the same
    // day all survive and a past record cannot be altered by changing
    // today's price. Public read so the storefront can show the update
    // history alongside the calendar.
    match /priceUpdates/{updateId} {
      allow read: if true;
      allow create: if isAdmin() &&
                       request.resource.data.keys().hasOnly(['sell', 'buy', 'margin', 'weight', 'pricePerGram', 'productName', 'productId', 'date', 'updatedBy', 'recordedAt']) &&
                       request.resource.data.sell is number && request.resource.data.sell > 0 &&
                       request.resource.data.buy is number && request.resource.data.buy > 0 &&
                       request.resource.data.weight is number && request.resource.data.weight > 0 &&
                       request.resource.data.date is string &&
                       // Same +/-0.01 tolerance as priceHistory: exact float
                       // equality rejects ordinary decimal rates.
                       request.resource.data.margin >= (request.resource.data.sell - request.resource.data.buy) - 0.01 &&
                       request.resource.data.margin <= (request.resource.data.sell - request.resource.data.buy) + 0.01 &&
                       request.resource.data.recordedAt == request.time;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------- subscribers
    // Newsletter subscribers. Deliberately fully admin-gated here, unlike
    // consultations (which allows a public create) — subscribing,
    // resubscribing and unsubscribing all go through app/api/newsletter/*
    // routes using firebase-admin (which bypasses these rules entirely), the
    // same reasoning orders moved server-side for: a raw public-writable
    // collection would let a client set status directly, forge another
    // subscriber's unsubscribeToken, or spam duplicate/fake entries with no
    // way to validate the email actually exists. The admin dashboard reads
    // and manages this collection directly as the signed-in admin, exactly
    // like orders/consultations already do.
    match /subscribers/{subscriberId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------- newsletters
    // Draft/schedule authoring happens via direct client writes from the
    // admin dashboard (same as announcements) — only admins can touch this
    // collection at all. Actually SENDING a newsletter (calling Resend,
    // iterating subscribers, writing lastEmailSentAt on every one of them)
    // only ever happens through app/api/newsletter/send and
    // app/api/newsletter/cron, both server-side via firebase-admin, so the
    // Resend API key is never reachable from the browser.
    match /newsletters/{newsletterId} {
      allow read, write: if isAdmin();
    }

    // ----------------------------------------------------------- settings
    // Storefront reads system-wide flags (e.g. maintenance mode); only
    // admins can change them.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------- logs
    // Admin-only activity log — never readable or writable by the public,
    // only by a signed-in admin from the dashboard.
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------ default
    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
